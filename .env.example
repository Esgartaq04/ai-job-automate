# ---- Core ----
AUTOAPPLY_DATABASE_URL=postgresql+psycopg://autoapply:autoapply@localhost:5432/autoapply
AUTOAPPLY_ENV=local

# ---- Anthropic ----
# Required for match scoring, tailoring, field-mapping fallback and outcome classification.
ANTHROPIC_API_KEY=
# Cheap model: match scoring, field mapping, email classification.
AUTOAPPLY_MODEL_FAST=claude-haiku-4-5
# Capable model: resume bullet tailoring + cover letters.
AUTOAPPLY_MODEL_SMART=claude-opus-5

# ---- Embeddings ----
# local  = deterministic hashed-lexical embedder, no API key, no spend (default)
# voyage = Voyage AI (VOYAGE_API_KEY required); Anthropic has no embeddings endpoint
AUTOAPPLY_EMBEDDING_PROVIDER=local
AUTOAPPLY_EMBEDDING_DIM=1536
VOYAGE_API_KEY=

# ---- Artifacts ----
# local:///path  or  gs://bucket/prefix
AUTOAPPLY_ARTIFACT_URI=local:///var/lib/autoapply/artifacts

# ---- Submission ----
# Submission is approval-gated: nothing is ever submitted without an explicit
# approve action. This switch additionally short-circuits the final click so you
# can exercise the whole path against real forms without sending an application.
AUTOAPPLY_DRY_RUN=false
# Optional: point at a specific Chromium binary (system package, or a preinstalled
# build whose revision differs from the pinned playwright wheel). Empty = bundled.
AUTOAPPLY_CHROMIUM_PATH=
# Volume cap per user per rolling 24h. Keep human-plausible (README section 8).
AUTOAPPLY_DAILY_SUBMIT_CAP=25
# Confidence below which a mapped field escalates to needs_input instead of guessing.
AUTOAPPLY_FIELD_CONFIDENCE_FLOOR=0.7
# Free-text answers longer than this escalate when confidence is low.
AUTOAPPLY_FREETEXT_ESCALATE_CHARS=280

# ---- Pacing / rate limits ----
AUTOAPPLY_ATS_RATE_PER_MIN=20
AUTOAPPLY_CIRCUIT_FAILURE_THRESHOLD=5
AUTOAPPLY_SUBMIT_JITTER_SECONDS=45

# ---- Gmail (stage 5 outcome tracking) ----
# Desktop-app OAuth client JSON from Google Cloud Console, with the Gmail API
# enabled. Scope is gmail.readonly: AutoApply never sends or modifies mail.
AUTOAPPLY_GMAIL_CREDENTIALS_PATH=~/.config/autoapply/gmail_client_secret.json
AUTOAPPLY_GMAIL_TOKEN_PATH=~/.config/autoapply/gmail_token.json
AUTOAPPLY_GMAIL_QUERY=newer_than:14d -category:promotions

# ---- API ----
AUTOAPPLY_API_HOST=0.0.0.0
AUTOAPPLY_API_PORT=8000
# Single-user Phase 1: this token guards every mutating endpoint.
AUTOAPPLY_API_TOKEN=dev-token-change-me
